# Built artifacts — regenerated by the indexer, published by CI
graph/*.duckdb
graph/*.duckdb.wal
__pycache__/
*.pyc
.venv/

# Generated by the Confluence ingester and reconciler - drafts are for human triage,
# not for committing. Reviewed drafts get promoted into disagreements/ by hand.
tools/confluence/out/
.venv-mcp/
.venv-mcp
.e5/unlock.json

# Credentials NEVER live in this repo (they are in ~/.e5/credentials.md). Belt and braces:
/credentials.md
git_credentails.md
*.credentials.md
.env

# Per-person local state: audit log, unlocks, change sets. Never shared.
.e5/

# Platform repo checkouts, laid out by tools/checkouts.py from the bare mirrors
/platform/

# Generated by /e5-sync on each machine. Only graph/citation-anchors.json and
# graph/deployed.json are committed (hand-verified, shared by the team).
/graph/*
!/graph/citation-anchors.json
!/graph/deployed.json
